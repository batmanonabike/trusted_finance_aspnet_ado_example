@using TrustedAbstractions
@model List<Book>

@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
</div>

@if (Model.Count == 0)
{
    <p>No books found, what a boring library!</p>
    <form asp-action="PopulateTestData" method="post">
        Why don't you...        
        <button type="submit" class="btn btn-primary">
            Create some!
        </button>
    </form>
}

@if (Model.Count != 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Published date</th>
                    <th>Genre</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.PublishDate</td>
                        <td>@book.Genre</td>
                        <td>@book.Price.ToString("C")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-secondary">
                                    Edit
                                </a>

                                <form asp-action="DeleteBook" asp-route-id="@book.BookId" method="post">
                                    <button type="submit" class="btn btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <form asp-action="PopulateTestData" method="post">
        <button type="submit" class="btn btn-primary">
            Create more books!
        </button>
    </form>
}

